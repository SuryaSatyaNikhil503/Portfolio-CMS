generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model About {
  id           String   @id @default(cuid())
  name         String
  title        String   @default("")
  profileImage String   @default("")
  bio          Json     @default("{}")
  resumeLink   String   @default("")
  openToWork   Boolean  @default(true)
  githubUrl    String   @default("")
  linkedinUrl  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("about")
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  thumbnail   String     @default("")
  excerpt     String     @default("")
  content     Json       @default("{}")
  tags        String[]   @default([])
  published   Boolean    @default(false)
  readingTime String     @default("1 min read")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  views       BlogView[]
  comments    Comment[]
  pageViews   PageView[]

  @@map("blogs")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  thumbnail    String   @default("")
  techStack    String[] @default([])
  githubLink   String   @default("")
  liveDemoLink String   @default("")
  description  Json     @default("{}")
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

model Experience {
  id           String   @id @default(cuid())
  company      String
  role         String
  companyLogo  String   @default("")
  location     String   @default("")
  startDate    String
  endDate      String   @default("Present")
  description  String   @default("")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("experiences")
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  icon         String   @default("")
  category     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skills")
}

model Subscriber {
  id           String   @id @default(cuid())
  name         String   @default("")
  email        String   @unique
  profession   String   @default("")
  location     String   @default("")
  phone        String   @default("")
  subscribedAt DateTime @default(now())
  sessions     VisitSession[]

  @@map("subscribers")
}

model BlogView {
  id        String   @id @default(cuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  source    String   @default("Direct")
  referrer  String   @default("")
  createdAt DateTime @default(now())

  @@map("blog_views")
}

model Comment {
  id          String            @id @default(cuid())
  blogId      String
  blog        Blog              @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  parentId    String?
  parent      Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]         @relation("Replies")
  adminReply  String            @default("")
  isApproved  Boolean           @default(true)
  reactions   CommentReaction[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@map("comment_reactions")
}

// ---- Visitor analytics (anonymous: no IP address, no cookies, no identifiers) ----

model VisitSession {
  id           String       @id // random id the browser keeps in sessionStorage; gone when the tab closes
  startedAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  source       String       @default("Direct")
  referrerHost String       @default("")
  referrer     String       @default("") // scheme + host + path only, never the query string
  device       String       @default("desktop")
  os           String       @default("")
  browser      String       @default("")
  country      String       @default("")
  city         String       @default("")
  subscriberId String? // set only when the visitor ticked "let me see which pages I read" while subscribing
  subscriber   Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  views        PageView[]
  events       VisitEvent[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([source])
  @@map("visit_sessions")
}

model PageView {
  id            String       @id @default(cuid())
  sessionId     String
  session       VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path          String
  title         String       @default("")
  blogId        String?
  blog          Blog?        @relation(fields: [blogId], references: [id], onDelete: SetNull)
  seq           Int
  enteredAt     DateTime     @default(now())
  activeSeconds Int          @default(0)
  scrollDepth   Int          @default(0)

  @@unique([sessionId, seq])
  @@index([blogId, enteredAt])
  @@index([enteredAt])
  @@map("page_views")
}

model VisitEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  path      String       @default("")
  createdAt DateTime     @default(now())

  @@index([sessionId])
  @@index([name, createdAt])
  @@map("visit_events")
}
